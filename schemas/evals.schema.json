{
  "$defs": {
    "EvalCase": {
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Id"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "expected_output": {
          "title": "Expected Output",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "assertions": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/StructuredAssertion"
              }
            ]
          },
          "title": "Assertions",
          "type": "array"
        },
        "should_trigger": {
          "default": true,
          "title": "Should Trigger",
          "type": "boolean"
        },
        "force_skill_invocation": {
          "default": false,
          "title": "Force Skill Invocation",
          "type": "boolean"
        },
        "stage_files": {
          "default": false,
          "title": "Stage Files",
          "type": "boolean"
        },
        "side_effect_level": {
          "default": "local-only",
          "enum": [
            "static",
            "local-only",
            "live-safe",
            "live-external"
          ],
          "title": "Side Effect Level",
          "type": "string"
        },
        "side_effect_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/SideEffectContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "prompt",
        "expected_output"
      ],
      "title": "EvalCase",
      "type": "object"
    },
    "SideEffectContract": {
      "additionalProperties": false,
      "description": "Optional first-class side-effect allowance for an eval case.",
      "properties": {
        "allow_new_local_branches": {
          "default": true,
          "title": "Allow New Local Branches",
          "type": "boolean"
        },
        "allow_new_remote_branches": {
          "default": true,
          "title": "Allow New Remote Branches",
          "type": "boolean"
        },
        "allow_new_commits": {
          "default": true,
          "title": "Allow New Commits",
          "type": "boolean"
        },
        "allow_new_review_requests": {
          "default": true,
          "title": "Allow New Review Requests",
          "type": "boolean"
        },
        "allow_worktree_changes": {
          "default": true,
          "title": "Allow Worktree Changes",
          "type": "boolean"
        }
      },
      "title": "SideEffectContract",
      "type": "object"
    },
    "StructuredAssertion": {
      "additionalProperties": false,
      "description": "A deterministic assertion with explicit fields instead of prose routing.",
      "properties": {
        "type": {
          "enum": [
            "file_exists",
            "file_not_exists",
            "file_contains",
            "file_not_contains",
            "file_unchanged",
            "command_ran",
            "command_not_ran",
            "tests_pass",
            "git_clean",
            "json_path",
            "json_path_not_exists"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contains"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "json_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Path"
        },
        "equals": {
          "default": null,
          "title": "Equals"
        }
      },
      "required": [
        "type"
      ],
      "title": "StructuredAssertion",
      "type": "object"
    }
  },
  "properties": {
    "skill_name": {
      "title": "Skill Name",
      "type": "string"
    },
    "evals": {
      "items": {
        "$ref": "#/$defs/EvalCase"
      },
      "title": "Evals",
      "type": "array"
    }
  },
  "required": [
    "skill_name",
    "evals"
  ],
  "title": "agent-skill-eval eval suite",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
